# Flare IM 服务端部署配置 —— 复制成 .env 后修改
#
#   cp deploy/.env.example deploy/.env
#   # 至少要填 FLARE_TOKEN_SECRET 和下面三项 Ed25519 密钥，其余可按需改
#
# compose 会自动读取同目录下的 .env。这份文件是**所有凭据的唯一来源**：
# 基础设施容器和 Flare 服务都从这里取，改一处即可，不用去翻 yml。

# ─────────────────────────────────────────────────────────────────────────────
# 令牌签名密钥（必填，没有默认值）
# ─────────────────────────────────────────────────────────────────────────────
#
# 刻意不给默认值：compose 里写的是 ${FLARE_TOKEN_SECRET:?...}，没设就直接报错退出。
# 这不是麻烦，是防止「用仓库里公开的示例密钥跑生产」——那等于任何人都能伪造
# 任意用户身份，而且**完全没有症状**：服务正常启动、登录正常、日志干净。
# 本项目真的踩过这个坑，所以护栏留在这里，别给它加默认值。
#
# 生成一个：
#   openssl rand -base64 48 | tr -d '\n' | head -c 64
#
# 核心与业务服务端必须用**同一个**密钥：业务侧签发的 IM 连接令牌要由核心网关校验，
# 两边不一致的表现是「登录成功但 IM 连不上」，排查成本很高。
FLARE_TOKEN_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Ed25519 密钥（必填，没有默认值）
# ─────────────────────────────────────────────────────────────────────────────
#
# 不给默认值的理由同上：模板里的密钥是公开的，拿它部署等于让任何人都能伪造
# 内部调用身份或管理断言。每项取值是一行：整个 PEM 文件做 base64。
#
# 内部上下文（Cell 密钥对）：api-gateway、signaling-gateway、admin-gateway 用私钥给
# 下游签发已验证身份，Media、Push Proxy、message-ingest 等用公钥校验。
# 业务服务端（flare-social）同栈部署时用**同一对**。生成：
#   openssl genpkey -algorithm Ed25519 -out cell-ctx.pem
#   openssl base64 -A -in cell-ctx.pem                          # 填 SIGNING_KEY
#   openssl pkey -in cell-ctx.pem -pubout | openssl base64 -A   # 填 PUBLIC_KEY
FLARE_INTERNAL_CTX_SIGNING_KEY=
FLARE_INTERNAL_CTX_PUBLIC_KEY=

# Control 公钥：Console/Control 用自己的私钥签管理断言，Core 的 online、capability、
# conversation、admin-gateway 只持公钥校验。填 Control 那对密钥的公钥（格式同上），
# 私钥留在 Control，不要放进这里。
FLARE_CONSOLE_PUBLIC_KEY=

# 服务端签发凭据（可选，未配置则签发接口不接受应用调用）。不与签名密钥复用。
# 格式：app_id:tenant_id:secret，多项用逗号分隔，secret 至少 16 字节。
# tenant_id 是凭据绑定的环境 app_id；请求不能覆盖。旧 app:secret 格式拒绝启动。
FLARE_API_GATEWAY_AUTH_APP_CREDENTIALS=

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
# 库名保持 flare2：init.sql、config/base.toml 的默认值、以及既有开发库都是它。
# 改库名的话这三处要一起改，否则服务连得上实例、找不到表。
POSTGRES_USER=flare
POSTGRES_PASSWORD=flare123
POSTGRES_DB=flare2

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
# 留空表示不启用密码（本地开发默认）。生产务必设置。
REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# 对象存储（RustFS，S3 兼容）
# ─────────────────────────────────────────────────────────────────────────────
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# ─────────────────────────────────────────────────────────────────────────────
# Grafana（可观测面板，非必需）
# ─────────────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─────────────────────────────────────────────────────────────────────────────
# 镜像与日志
# ─────────────────────────────────────────────────────────────────────────────
# 用预构建镜像时指定它；走本地构建（docker-compose.build.yml）时这一项被忽略。
FLARE_IMAGE=ghcr.io/flare-im/flare-im-core:latest

RUST_LOG=info

# 生产必须显式配置真实离线推送通道；production + outbox 会拒绝启动。
FLARE_ENV=development
PUSH_WORKER_OFFLINE_DELIVERY_BACKEND=outbox
# PUSH_WORKER_FCM_SERVICE_ACCOUNT_JSON=
# PUSH_WORKER_APNS_TEAM_ID=
# PUSH_WORKER_APNS_KEY_ID=
# PUSH_WORKER_APNS_PRIVATE_KEY=
# PUSH_WORKER_APNS_TOPIC=
# PUSH_WORKER_APNS_SANDBOX=true
