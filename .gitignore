# 构建产物
/target/
# Cargo.lock 入库：本仓产出 17 个服务端二进制，锁文件是可复现构建
# 与供应链审计（cargo audit 结果稳定）的前提。

# IDE / 本地工具状态
/.cargo/
/.idea/
/.vscode/
/.cursor/
/.github/
.DS_Store

# 运行时数据
/data/
/deploy/data/

# 本地配置覆盖（不提交到 Git）
config/overrides/local.toml
.env.local
.env.*.local
release/deploy.env
release/*.env
!release/*.env.example
release/dist/

# 本地临时工作区
/dev/
/doc/
/tests/

# 临时文件
*.log
*.tmp
/tmp/

# 日志目录
logs/
*.pid

# 本地开发证书(用 flare-core 的 rcgen 自生成,勿提交)
certs/
