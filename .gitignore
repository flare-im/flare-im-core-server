# 构建产物
/target/
# Cargo.lock 入库：本仓产出 17 个服务端二进制，锁文件是可复现构建
# 与供应链审计（cargo audit 结果稳定）的前提。

# IDE / 本地工具状态
/.idea/
/.vscode/
/.cursor/
.DS_Store

# 注意：`/.cargo/` 与 `/.github/` 曾被列在上面，但它们装的是**项目配置**
# （cargo 配置 / 审计豁免 / CI workflow），不是本地工具状态。
# 后果是新增文件被静默忽略——`nightly-e2e.yml` 和 `publish-image.yml`
# 就这样写完却从没进过仓库，GitHub 上压根不存在这两个 workflow。
# 只忽略真正属于本地的凭据文件。
/.cargo/credentials
/.cargo/credentials.toml

# 运行时数据
/data/
/deploy/data/

# 本地配置覆盖（不提交到 Git）
config/overrides/local.toml
.env.local
.env.*.local
release/deploy.env
release/*.env
!release/*.env.example
release/dist/

# 本地临时工作区
/dev/
/doc/
/tests/

# 临时文件
*.log
*.tmp
/tmp/

# 日志目录
logs/
*.pid

# 本地开发证书(用 flare-core 的 rcgen 自生成,勿提交)
certs/
