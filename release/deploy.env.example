# Copy to release/deploy.env for one-command remote operations.
#
# Minimal password-based setup:
#   FLARE_DEPLOY_HOST=203.0.113.10
#   FLARE_DEPLOY_USER=root
#   FLARE_DEPLOY_PASSWORD=change-me
#
# Then run:
#   ./release/flarectl.sh deploy --smoke

FLARE_DEPLOY_HOST=
FLARE_DEPLOY_USER=root
FLARE_DEPLOY_PASSWORD=

# Optional SSH settings.
FLARE_DEPLOY_SSH_PORT=22
# FLARE_DEPLOY_IDENTITY_FILE=/Users/me/.ssh/id_ed25519
# FLARE_DEPLOY_PASSWORD_FILE=/Users/me/.flare-im-core.password

# Remote install root. Releases go under $FLARE_DEPLOY_REMOTE_DIR/releases,
# persistent data/logs/pids under $FLARE_DEPLOY_REMOTE_DIR/shared.
FLARE_DEPLOY_REMOTE_DIR=/opt/flare-im-core

# Build and release package defaults.
FLARE_DEPLOY_PROFILE=release
FLARE_DEPLOY_JOBS=1
# auto: Docker on macOS/non-Linux, host build on Linux.
FLARE_DEPLOY_BUILD_MODE=auto
# FLARE_DOCKER_CARGO_REGISTRY_MIRROR=sparse+https://mirrors.ustc.edu.cn/crates.io-index/
# FLARE_DEPLOY_PACKAGE_DIR=/path/to/existing/release-bundle
# FLARE_DEPLOY_SKIP_BUILD=1

# Set to 1 when you want deploy/restart to run smoke by default.
FLARE_DEPLOY_SMOKE=0
FLARE_DEPLOY_TAIL_LINES=120
