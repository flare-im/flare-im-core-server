# Copy this file to .env in the generated release bundle and change secrets.

# Runtime profile
FLARE_MQ_DEFAULT_BACKEND=nats
RUST_LOG=info,hyper=warn,reqwest=warn,h2=warn,tower=warn,tokio=warn,sqlx=warn,tonic=warn,redis=warn,async_nats=warn

# Required in production-like deployments. Use the same secret for API and access
# gateway during smoke testing, then rotate per environment.
FLARE_API_GATEWAY_TOKEN_SECRET=change-me-at-least-32-bytes
ACCESS_GATEWAY_TOKEN_SECRET=change-me-at-least-32-bytes
FLARE_ADMIN_GATEWAY_TOKEN_SECRET=change-me-at-least-32-bytes

# Local service endpoints inside the single VM.
SMOKE_MESSAGE_INGEST_ENDPOINT=127.0.0.1:50182
SMOKE_STORAGE_READER_ENDPOINT=127.0.0.1:60083
SMOKE_POSTGRES_URL=postgres://flare:flare123@localhost:25432/flare2

# Docker infra credentials used by docker-compose.infra.yml and config/base.toml.
POSTGRES_USER=flare
POSTGRES_PASSWORD=flare123
POSTGRES_DB=flare2
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
