# Copy this file to .env in the generated release bundle and change secrets.

# Runtime profile
FLARE_MQ_DEFAULT_BACKEND=nats
RUST_LOG=info,hyper=warn,reqwest=warn,h2=warn,tower=warn,tokio=warn,sqlx=warn,tonic=warn,redis=warn,async_nats=warn

# Required in production-like deployments. Use the same secret for API and access
# gateway during smoke testing, then rotate per environment.
FLARE_API_GATEWAY_TOKEN_SECRET=change-me-at-least-32-bytes
ACCESS_GATEWAY_TOKEN_SECRET=change-me-at-least-32-bytes
# The platform (flare-platform) Ed25519 public key, not the end-user HMAC secret: it verifies
# only the projection worker (Capability TenantProjection) and the scheduler (Online KickTenant).
# Employees reach Core as a Staff x-flare-ctx signed by the Social gateway admin partition.
# Base64-encode the PEM public key for one-line dotenv transport when needed.
FLARE_PLATFORM_PUBLIC_KEY=
# Push Proxy verifies the same Cell-scoped signed context as the other Core
# protected ingress services. The public key is safe to distribute; do not
# inject the Cell private key into Push Proxy.
FLARE_INTERNAL_CTX_PUBLIC_KEY=
# Optional Cell key set by component key id (JSON {"gateway": "<key>", ...} or a directory of
# <kid>.pem files), layered over the single key above. Core admin surfaces accept Staff only
# from kid=gateway; Media accepts Admin Gateway's re-signed context as kid=admin-gateway.
FLARE_INTERNAL_CTX_PUBLIC_KEYS=
# Start the Core admin surface (Admin Gateway); its only caller is the Social gateway admin
# partition. Management effect events go to FLARE_AUDIT_NATS_URL when set.
FLARE_ADMIN_GATEWAY_ENABLED=
FLARE_AUDIT_NATS_URL=
# Push delivery remains intentionally paused until authenticated broker event
# provenance is deployed end to end. `signed-v1` is reserved but not accepted.
PUSH_WORKER_EVENT_PROVENANCE_MODE=paused
# Upstream Push Server consumption is paused for the same reason. Broker
# retention is bounded; this is a release blocker, not a permanent queue.
PUSH_SERVER_EVENT_PROVENANCE_MODE=paused
PUSH_PROXY_EVENT_PROVENANCE_MODE=paused

# Message-flow smoke (scripts/smoke.sh) runs only through the public Edge with
# Social login; the old direct gRPC settings were removed and are rejected.
# SMOKE_BASE_URL=https://im.example.test
# SMOKE_CA_FILE=/path/to/edge-ca.pem
# SMOKE_TENANT_ID=e2e-0123456789abcdef0123
# SMOKE_PG_CONTAINER=<postgres container>

# Docker infra credentials used by docker-compose.infra.yml and config/base.toml.
POSTGRES_USER=flare
POSTGRES_PASSWORD=flare123
POSTGRES_DB=flare2
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# 容量上限。默认值按「单机跑完整 IM 核 + flare-social 业务栈」估算，按机器实际调整。
# 这两项都属于「不够用时没有告警、只表现为发消息失败」的类型：
#   POSTGRES_MAX_CONNECTIONS 不够 → "sorry, too many clients already"，但服务端日志 outcome=ok
#   NATS_MAX_FILE_STORE 被写满    → publish 返回 insufficient resources(10023)，会话不物化
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_MEM_LIMIT=2048m
NATS_MAX_FILE_STORE=10GB
NATS_MAX_MEM_STORE=256MB

# PostgreSQL 内存参数。docker-compose.infra.yml 已把它们 env 参数化，这里覆盖默认值。
# 默认是中档基线（约 8-16G 机型）；按机器规格调整时用 scripts/plan_mem_budget.py 计算最优值
# （它按物理内存/核数推算 mem_limit + 这组参数），scripts/check_memory_budget.sh 校验现状。
# effective_cache_size 是规划器提示、不占 RAM，应反映整机可缓存量（shared_buffers + 内核页缓存）。
POSTGRES_SHARED_BUFFERS=768MB
POSTGRES_EFFECTIVE_CACHE_SIZE=9600MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_WAL_BUFFERS=32MB
POSTGRES_WAL_COMPRESSION=on
# 预加载库：timescaledb（超表/列存压缩）+ pg_stat_statements（慢查询定位）。
POSTGRES_SHARED_PRELOAD_LIBRARIES=timescaledb,pg_stat_statements

# KV 后端 Dragonfly（服务名仍为 redis）。maxmemory 应显著低于 mem_limit（约 70%）留缓冲；
# Dragonfly 用快照持久化（无 AOF），snapshot_cron 控制快照频率。
REDIS_MAXMEMORY=1792mb
REDIS_MEM_LIMIT=2560m
REDIS_SNAPSHOT_CRON=*/2 * * * *
