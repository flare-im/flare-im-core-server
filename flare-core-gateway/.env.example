# HTTP 服务器配置
SERVER_BIND=0.0.0.0
SERVER_PORT=50050
SERVER_TIMEOUT_SECS=30
SERVER_MAX_BODY_SIZE=10485760

# 下游 gRPC：默认走服务发现（K8s / Consul / Mesh），无需写端口
# GRPC_MEDIA_SERVICE_URL=discovery://flare-media
# GRPC_MESSAGE_SERVICE_URL=discovery://flare-orchestrator
# GRPC_CONVERSATION_SERVICE_URL=discovery://flare-conversation

# 本地无注册中心时的静态回退（与 config/services/*.toml 中 server.port 对齐）
GRPC_MEDIA_STATIC_FALLBACK=http://127.0.0.1:60081
GRPC_MESSAGE_STATIC_FALLBACK=http://127.0.0.1:50181
GRPC_CONVERSATION_STATIC_FALLBACK=http://127.0.0.1:50090

GRPC_CONNECT_TIMEOUT_SECS=5
GRPC_REQUEST_TIMEOUT_SECS=10

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=1000
RATE_LIMIT_BURST=2000

# 追踪配置
TRACING_ENABLED=true
TRACING_SERVICE_NAME=flare-gateway
TRACING_SAMPLE_RATE=1.0
