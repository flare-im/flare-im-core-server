# HTTP 服务器配置
SERVER_BIND=0.0.0.0
SERVER_PORT=50050
SERVER_TIMEOUT_SECS=30
SERVER_MAX_BODY_SIZE=10485760

# gRPC 服务地址
GRPC_MEDIA_SERVICE_URL=http://localhost:50051
GRPC_MESSAGE_SERVICE_URL=http://localhost:50052
GRPC_CONVERSATION_SERVICE_URL=http://localhost:50053
GRPC_CONNECT_TIMEOUT_SECS=5
GRPC_REQUEST_TIMEOUT_SECS=10

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=1000
RATE_LIMIT_BURST=2000

# 追踪配置
TRACING_ENABLED=true
TRACING_SERVICE_NAME=flare-gateway
TRACING_SAMPLE_RATE=1.0
