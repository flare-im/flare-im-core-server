# HTTP 服务器配置
FLARE_CORE_GATEWAY_SERVER_BIND=0.0.0.0
FLARE_CORE_GATEWAY_SERVER_PORT=50050
FLARE_CORE_GATEWAY_SERVER_TIMEOUT_SECS=30
FLARE_CORE_GATEWAY_SERVER_MAX_BODY_SIZE=10485760

# 下游 gRPC：默认走服务发现（K8s / Consul / Mesh），无需写端口
# FLARE_CORE_GATEWAY_GRPC_MEDIA_SERVICE_URL=discovery://flare-media
# FLARE_CORE_GATEWAY_GRPC_MESSAGE_SERVICE_URL=discovery://flare-orchestrator
# FLARE_CORE_GATEWAY_GRPC_CONVERSATION_SERVICE_URL=discovery://flare-conversation
# FLARE_CORE_GATEWAY_GRPC_STORAGE_READER_SERVICE_URL=discovery://flare-storage-reader

# 本地无注册中心时的静态回退（与 config/services/*.toml 中 server.port 对齐）
FLARE_CORE_GATEWAY_GRPC_MEDIA_STATIC_FALLBACK=http://127.0.0.1:60081
FLARE_CORE_GATEWAY_GRPC_MESSAGE_STATIC_FALLBACK=http://127.0.0.1:50181
FLARE_CORE_GATEWAY_GRPC_CONVERSATION_STATIC_FALLBACK=http://127.0.0.1:50090
FLARE_CORE_GATEWAY_GRPC_STORAGE_READER_STATIC_FALLBACK=http://127.0.0.1:60083

FLARE_CORE_GATEWAY_GRPC_CONNECT_TIMEOUT_SECS=5
FLARE_CORE_GATEWAY_GRPC_REQUEST_TIMEOUT_SECS=10

# 认证配置
# core_jwt: 使用 core_gateway.toml 中的 token_secret/token_issuer 和 trusted_token_issuers
# http_hook: 调用业务系统外部 hook 校验 token
FLARE_CORE_GATEWAY_AUTH_MODE=core_jwt
# FLARE_CORE_GATEWAY_AUTH_MODE=http_hook
# FLARE_CORE_GATEWAY_AUTH_HOOK_URL=http://127.0.0.1:8088/internal/auth/validate
FLARE_CORE_GATEWAY_AUTH_HOOK_TIMEOUT_MS=800
# FLARE_CORE_GATEWAY_AUTH_HOOK_SECRET=change-me
# FLARE_CORE_GATEWAY_AUTH_HOOK_SECRET_HEADER=x-flare-auth-hook-secret

# 限流配置
FLARE_CORE_GATEWAY_RATE_LIMIT_ENABLED=true
FLARE_CORE_GATEWAY_RATE_LIMIT_RPS=1000
FLARE_CORE_GATEWAY_RATE_LIMIT_BURST=2000

# 追踪配置
FLARE_CORE_GATEWAY_TRACING_ENABLED=true
FLARE_CORE_GATEWAY_TRACING_SERVICE_NAME=flare-core-gateway
FLARE_CORE_GATEWAY_TRACING_SAMPLE_RATE=1.0
