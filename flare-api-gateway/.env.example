# API Gateway 环境变量示例（前缀 FLARE_API_GATEWAY_，见 flare-im-service-kit 的 env_registry）
#
# 监听地址与端口不走环境变量：取 config/services/api-gateway.toml 的
# [services.api_gateway.server] address / port（默认 0.0.0.0:50050）。
# 旧前缀 FLARE_CORE_GATEWAY_* 不再读取；FLARE_API_GATEWAY_SERVER_BIND、_SERVER_PORT、
# _SERVER_TIMEOUT_SECS 与 FLARE_API_GATEWAY_TRACING_* 不读取（出现时启动日志 WARN），不必设置。

# 请求体上限（字节），缺省 16 MiB
FLARE_API_GATEWAY_SERVER_MAX_BODY_SIZE=16777216

# 下游 gRPC：默认走服务发现（K8s / Consul / Mesh），无需写端口
# FLARE_API_GATEWAY_GRPC_MEDIA_SERVICE_URL=discovery://flare-media
# FLARE_API_GATEWAY_GRPC_MESSAGE_INGEST_SERVICE_URL=discovery://flare-message-ingest
# FLARE_API_GATEWAY_GRPC_MESSAGE_ORCHESTRATOR_SERVICE_URL=discovery://flare-orchestrator
# FLARE_API_GATEWAY_GRPC_CONVERSATION_SERVICE_URL=discovery://flare-conversation
# FLARE_API_GATEWAY_GRPC_ONLINE_SERVICE_URL=discovery://flare-signaling-online
# FLARE_API_GATEWAY_GRPC_STORAGE_READER_SERVICE_URL=discovery://flare-storage-reader

# 本地无注册中心时的静态回退（与 config/services/*.toml 中 server.port 对齐；下面是缺省值）
FLARE_API_GATEWAY_GRPC_MEDIA_STATIC_FALLBACK=http://127.0.0.1:60081
FLARE_API_GATEWAY_GRPC_MESSAGE_INGEST_STATIC_FALLBACK=http://127.0.0.1:50182
FLARE_API_GATEWAY_GRPC_MESSAGE_ORCHESTRATOR_STATIC_FALLBACK=http://127.0.0.1:50181
FLARE_API_GATEWAY_GRPC_CONVERSATION_STATIC_FALLBACK=http://127.0.0.1:50090
FLARE_API_GATEWAY_GRPC_ONLINE_STATIC_FALLBACK=http://127.0.0.1:50061
FLARE_API_GATEWAY_GRPC_STORAGE_READER_STATIC_FALLBACK=http://127.0.0.1:60083

# 设备推送令牌接口直连 Push Proxy 的静态地址；缺省为 single 拓扑同容器地址
# FLARE_API_GATEWAY_GRPC_PUSH_PROXY_URL=http://127.0.0.1:50091
# 每次下游 gRPC 调用（会话、在线、消息、Media、Push Proxy）的请求超时（秒），缺省 10，0 拒绝启动；
# 含排队等客户端的时间。超时回可重试的 503（Media 为 504 MEDIA_TIMEOUT），HTTP 发送带同一
# client_msg_id 重试即可；Media 文件下载只限到下载流打开为止，之后的传输不限时
FLARE_API_GATEWAY_GRPC_REQUEST_TIMEOUT_SECS=10
# 静态下游地址（上面的 http:// 覆盖，以及 discovery:// 发现失败后的静态回退）一次建连的上限（秒），
# 缺省 2，0 拒绝启动；discovery:// 发现到的实例由服务发现客户端建连
FLARE_API_GATEWAY_GRPC_CONNECT_TIMEOUT_SECS=2

# HTTP 发消息（/api/v1/messages/send）给摄入侧签身份上下文用的 Cell 私钥（PEM）。
# 只从秘密注入，不写进任何文件；缺失时 HTTP 发送 fail closed。
# FLARE_INTERNAL_CTX_PRIVATE_KEY=

# 认证配置
# core_jwt: 用 FLARE_API_GATEWAY_TOKEN_SECRET（或 api-gateway.toml 的 token_secret）与
#           trusted_token_issuers 校验 token
# http_hook: 调用业务系统外部 hook 校验 token
FLARE_API_GATEWAY_AUTH_MODE=core_jwt
# FLARE_API_GATEWAY_AUTH_MODE=http_hook
# FLARE_API_GATEWAY_AUTH_HOOK_URL=http://127.0.0.1:8088/internal/auth/validate
FLARE_API_GATEWAY_AUTH_HOOK_TIMEOUT_MS=800
# FLARE_API_GATEWAY_AUTH_HOOK_SECRET=change-me
# FLARE_API_GATEWAY_AUTH_HOOK_SECRET_HEADER=x-flare-auth-hook-secret

# 签名密钥：至少 32 字节的随机值，只从秘密注入，不写进仓库
# FLARE_API_GATEWAY_TOKEN_SECRET=

# 租户准入：strict 时必须能读到租户运行时投影库
# FLARE_API_GATEWAY_TENANT_POLICY=lenient
# FLARE_API_GATEWAY_TENANT_RUNTIME_POSTGRES_URL=

# 限流配置：网关进程一个令牌桶，超出回 429（RATE_LIMITED），/health 不计入
FLARE_API_GATEWAY_RATE_LIMIT_ENABLED=true
FLARE_API_GATEWAY_RATE_LIMIT_RPS=1000
FLARE_API_GATEWAY_RATE_LIMIT_BURST=2000

# ── 接入 token 签发/刷新（POST /api/v1/auth/tokens, /api/v1/auth/tokens/refresh）──
# 业务后端签发凭据（客户端永远不持有）："app1:tenant1:secret1,app2:tenant2:secret2"，secret ≥16 字节
# tenantId 缺省时由凭据注入；与绑定租户不一致返回 403。旧双字段格式不再支持。
# FLARE_API_GATEWAY_AUTH_APP_CREDENTIALS=
# 联调开关：允许不带凭据直接按 userId 签发。默认 false；开启等于任何人可冒任意身份。
# FLARE_ENV=production 时开启，网关拒绝启动。
FLARE_API_GATEWAY_AUTH_DEV_ISSUE=false
# 刷新宽限：token 过期后多久内仍可换新（秒），默认 7 天
FLARE_API_GATEWAY_AUTH_REFRESH_GRACE_SECS=604800
# http_hook 模式下签发/刷新转发地址；未配则签发接口回 501（已委托给业务认证系统）
# FLARE_API_GATEWAY_AUTH_HOOK_ISSUE_URL=http://127.0.0.1:8088/internal/auth/issue
